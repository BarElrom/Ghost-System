# GHOST v2 injection firmware — minimal defaults
# UART console at 921600 to match the ghost gateway serial reader.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# Give the UDP task headroom; printing 128 values/line at 100 Hz is I/O heavy.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
